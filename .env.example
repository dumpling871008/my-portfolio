# Cloud Run API。若未設定 PUBLIC_MESSAGE_API_URL，留言表單會從
# PUBLIC_CHAT_API_URL 的 /api/chat 自動推導為 /api/messages。
PUBLIC_CHAT_API_URL=http://localhost:8080/api/chat
PUBLIC_MESSAGE_API_URL=http://localhost:8080/api/messages

# Cloudflare Turnstile site key 是公開值；secret key 只可放在 Flask / Cloud Run。
PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
