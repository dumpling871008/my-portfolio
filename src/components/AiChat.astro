---
const apiUrl =
  import.meta.env.PUBLIC_AI_API_URL ?? "http://127.0.0.1:5000";
---

<div class="ai-chat" data-api-url={apiUrl}>
  <section
    id="ai-chat-panel"
    class="ai-chat__panel"
    aria-label="AI 詢問助手"
    hidden
  >
    <header class="ai-chat__header">
      <div>
        <strong>詢問君璇的 AI</strong>
        <p>你可以詢問我的經歷、技能與專案</p>
      </div>

      <button
        id="ai-chat-close"
        class="ai-chat__close"
        type="button"
        aria-label="關閉聊天視窗"
      >
        ×
      </button>
    </header>

    <div id="ai-chat-messages" class="ai-chat__messages">
      <div class="ai-message ai-message--assistant">
        你好！你可以問我「君璇做過哪些專案？」
      </div>
    </div>

    <form id="ai-chat-form" class="ai-chat__form">
      <input
        id="ai-chat-input"
        type="text"
        maxlength="500"
        placeholder="輸入想詢問的問題"
        autocomplete="off"
        required
      />

      <button id="ai-chat-submit" type="submit">
        傳送
      </button>
    </form>
  </section>

  <button
    id="ai-chat-toggle"
    class="ai-chat__toggle"
    type="button"
    aria-controls="ai-chat-panel"
    aria-expanded="false"
  >
    詢問 AI
  </button>
</div>

<script>
  const chatRoot = document.querySelector<HTMLElement>(".ai-chat");
  const panel = document.querySelector<HTMLElement>("#ai-chat-panel");
  const toggleButton =
    document.querySelector<HTMLButtonElement>("#ai-chat-toggle");
  const closeButton =
    document.querySelector<HTMLButtonElement>("#ai-chat-close");
  const form = document.querySelector<HTMLFormElement>("#ai-chat-form");
  const input = document.querySelector<HTMLInputElement>("#ai-chat-input");
  const submitButton =
    document.querySelector<HTMLButtonElement>("#ai-chat-submit");
  const messages =
    document.querySelector<HTMLElement>("#ai-chat-messages");

  function setPanel(open: boolean) {
    if (!panel || !toggleButton) return;

    panel.hidden = !open;
    toggleButton.setAttribute("aria-expanded", String(open));

    if (open) {
      input?.focus();
    }
  }

  function addMessage(
    text: string,
    role: "user" | "assistant",
  ): HTMLDivElement | null {
    if (!messages) return null;

    const message = document.createElement("div");
    message.className = `ai-message ai-message--${role}`;
    message.textContent = text;

    messages.appendChild(message);
    messages.scrollTop = messages.scrollHeight;

    return message;
  }

  toggleButton?.addEventListener("click", () => {
    setPanel(panel?.hidden ?? true);
  });

  closeButton?.addEventListener("click", () => {
    setPanel(false);
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    const question = input?.value.trim();
    const apiUrl = chatRoot?.dataset.apiUrl;

    if (!question || !apiUrl || !input || !submitButton) return;

    addMessage(question, "user");
    input.value = "";
    input.disabled = true;
    submitButton.disabled = true;

    const loadingMessage = addMessage("正在查詢資料……", "assistant");

    try {
      const response = await fetch(`${apiUrl}/api/chat`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          question,
        }),
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.error ?? "AI 服務發生錯誤");
      }

      if (loadingMessage) {
        loadingMessage.textContent = data.response;
      }
    } catch (error) {
      if (loadingMessage) {
        loadingMessage.textContent =
          error instanceof Error
            ? error.message
            : "目前無法連線到 AI 服務。";
      }
    } finally {
      input.disabled = false;
      submitButton.disabled = false;
      input.focus();
    }
  });
</script>

<style is:global>
  .ai-chat {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 50;
    font-family: inherit;
  }

  .ai-chat__toggle {
    border: 0;
    border-radius: 999px;
    padding: 12px 20px;
    background: #171717;
    color: white;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 8px 30px rgb(0 0 0 / 18%);
  }

  .ai-chat__panel {
    position: absolute;
    right: 0;
    bottom: 64px;
    display: flex;
    width: min(380px, calc(100vw - 32px));
    height: min(540px, calc(100vh - 100px));
    flex-direction: column;
    overflow: hidden;
    border: 1px solid #dedbd4;
    border-radius: 18px;
    background: #fff;
    color: #171717;
    box-shadow: 0 18px 60px rgb(0 0 0 / 18%);
  }

  .ai-chat__panel[hidden] {
    display: none;
  }

  .ai-chat__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 18px;
    border-bottom: 1px solid #e8e5df;
  }

  .ai-chat__header p {
    margin: 4px 0 0;
    color: #6d6a64;
    font-size: 13px;
  }

  .ai-chat__close {
    border: 0;
    background: transparent;
    font-size: 24px;
    cursor: pointer;
  }

  .ai-chat__messages {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 12px;
    overflow-y: auto;
    padding: 18px;
    background: #f8f7f4;
  }

  .ai-message {
    max-width: 85%;
    border-radius: 14px;
    padding: 10px 13px;
    font-size: 14px;
    line-height: 1.6;
    white-space: pre-wrap;
  }

  .ai-message--assistant {
    align-self: flex-start;
    border: 1px solid #e0ddd6;
    background: white;
  }

  .ai-message--user {
    align-self: flex-end;
    background: #171717;
    color: white;
  }

  .ai-chat__form {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 8px;
    padding: 14px;
    border-top: 1px solid #e8e5df;
  }

  .ai-chat__form input {
    min-width: 0;
    border: 1px solid #d7d3cb;
    border-radius: 10px;
    padding: 10px 12px;
    outline: none;
  }

  .ai-chat__form input:focus {
    border-color: #171717;
  }

  .ai-chat__form button {
    border: 0;
    border-radius: 10px;
    padding: 0 15px;
    background: #171717;
    color: white;
    cursor: pointer;
  }

  .ai-chat__form button:disabled {
    cursor: wait;
    opacity: 0.55;
  }

  @media (max-width: 480px) {
    .ai-chat {
      right: 16px;
      bottom: 16px;
    }
  }
</style>
