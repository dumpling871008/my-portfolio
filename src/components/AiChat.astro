---
const apiUrl = import.meta.env.PUBLIC_CHAT_API_URL?.trim() ?? "";
---

<div class="ai-chat" data-api-url={apiUrl}>
  <section
    id="ai-chat-panel"
    class="ai-chat__panel"
    aria-label="AI 詢問助手"
    hidden
  >
    <header class="ai-chat__header">
      <div>
        <strong>詢問君璇的 AI</strong>
        <p>你可以詢問我的經歷、技能與專案</p>
      </div>

      <button
        id="ai-chat-close"
        class="ai-chat__close"
        type="button"
        aria-label="關閉聊天視窗"
      >
        ×
      </button>
    </header>

    <div
      id="ai-chat-messages"
      class="ai-chat__messages"
      aria-live="polite"
    >
      <div class="ai-message ai-message--assistant">
        你好！你可以問我「君璇做過哪些專案？」
      </div>
    </div>

    <form id="ai-chat-form" class="ai-chat__form">
      <input
        id="ai-chat-input"
        type="text"
        maxlength="500"
        placeholder="輸入想詢問的問題"
        autocomplete="off"
        required
      />

      <button id="ai-chat-submit" type="submit">
        傳送
      </button>
    </form>
  </section>

  <button
    id="ai-chat-toggle"
    class="ai-chat__toggle"
    type="button"
    aria-controls="ai-chat-panel"
    aria-expanded="false"
  >
    詢問 AI
  </button>
</div>

<script>
  type ChatResponse = {
    response?: string;
    route?: string;
    source_ids?: string[];
    error?: string;
  };

  const REQUEST_TIMEOUT_MS = 30_000;
  const MAX_QUESTION_LENGTH = 500;

  const chatRoot = document.querySelector<HTMLElement>(".ai-chat");
  const panel = document.querySelector<HTMLElement>("#ai-chat-panel");
  const toggleButton =
    document.querySelector<HTMLButtonElement>("#ai-chat-toggle");
  const closeButton =
    document.querySelector<HTMLButtonElement>("#ai-chat-close");
  const form = document.querySelector<HTMLFormElement>("#ai-chat-form");
  const input = document.querySelector<HTMLInputElement>("#ai-chat-input");
  const submitButton =
    document.querySelector<HTMLButtonElement>("#ai-chat-submit");
  const messages =
    document.querySelector<HTMLElement>("#ai-chat-messages");

  function setPanel(open: boolean) {
    if (!panel || !toggleButton) return;

    panel.hidden = !open;
    toggleButton.setAttribute("aria-expanded", String(open));

    if (open) {
      input?.focus();
    }
  }

  function addMessage(
    text: string,
    role: "user" | "assistant",
  ): HTMLDivElement | null {
    if (!messages) return null;

    const message = document.createElement("div");
    message.className = `ai-message ai-message--${role}`;
    message.textContent = text;

    messages.appendChild(message);
    messages.scrollTop = messages.scrollHeight;

    return message;
  }

  function renderAssistantResponse(
    message: HTMLDivElement,
    data: ChatResponse,
  ) {
    const answer = data.response?.trim();
    if (!answer) return;

    message.textContent = "";

    if (data.route === "HANDOFF") {
      message.classList.add("ai-message--handoff");

      const handoffLabel = document.createElement("div");
      handoffLabel.className = "ai-message__handoff-label";
      handoffLabel.textContent = "建議進一步聯絡";
      message.appendChild(handoffLabel);
    }

    const answerText = document.createElement("div");
    answerText.className = "ai-message__answer";
    answerText.textContent = answer;
    message.appendChild(answerText);

    const sourceIds = Array.from(
      new Set(
        (data.source_ids ?? []).filter(
          (sourceId): sourceId is string =>
            typeof sourceId === "string" && Boolean(sourceId.trim()),
        ),
      ),
    );

    if (sourceIds.length === 0) return;

    const sources = document.createElement("div");
    sources.className = "ai-message__sources";

    const sourcesTitle = document.createElement("div");
    sourcesTitle.className = "ai-message__sources-title";
    sourcesTitle.textContent = "參考資料";

    const sourcesList = document.createElement("ul");
    sourcesList.className = "ai-message__sources-list";

    sourceIds.forEach((sourceId) => {
      const item = document.createElement("li");
      item.textContent = sourceId.trim();
      sourcesList.appendChild(item);
    });

    sources.append(sourcesTitle, sourcesList);
    message.appendChild(sources);
  }

  toggleButton?.addEventListener("click", () => {
    setPanel(Boolean(panel?.hidden ?? true));
  });

  closeButton?.addEventListener("click", () => {
    setPanel(false);
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    const question = input?.value.trim();
    const apiUrl = chatRoot?.dataset.apiUrl;

    if (!input || !submitButton) return;

    if (!question) {
      input.setCustomValidity("請輸入問題後再送出。");
      input.reportValidity();
      input.setCustomValidity("");
      return;
    }

    if (question.length > MAX_QUESTION_LENGTH) {
      input.setCustomValidity(`問題最多 ${MAX_QUESTION_LENGTH} 字。`);
      input.reportValidity();
      input.setCustomValidity("");
      return;
    }

    addMessage(question, "user");
    input.value = "";

    if (!apiUrl) {
      addMessage(
        "AI 服務尚未完成設定，請稍後再試。",
        "assistant",
      );
      return;
    }

    input.disabled = true;
    submitButton.disabled = true;

    const loadingMessage = addMessage("AI 正在思考中…", "assistant");
    const controller = new AbortController();
    const timeoutId = window.setTimeout(
      () => controller.abort(),
      REQUEST_TIMEOUT_MS,
    );

    try {
      const response = await fetch(apiUrl, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          question,
        }),
        signal: controller.signal,
      });

      const data: ChatResponse = await response.json().catch(() => ({}));

      if (!response.ok) {
        const message =
          data.error ??
          (response.status === 429
            ? "詢問次數較多，請稍後再試。"
            : response.status >= 500
              ? "AI 服務暫時忙碌，請稍後再試。"
              : "目前無法完成查詢，請稍後再試。");
        throw new Error(message);
      }

      if (typeof data.response !== "string" || !data.response.trim()) {
        throw new Error("AI 服務沒有傳回有效回答，請稍後再試。");
      }

      if (loadingMessage) {
        renderAssistantResponse(loadingMessage, data);
      }
    } catch (error) {
      if (loadingMessage) {
        loadingMessage.textContent =
          error instanceof Error && error.name === "AbortError"
            ? "AI 回應時間較長，請稍後再試一次。"
            : error instanceof TypeError
            ? "目前無法連線到 AI 服務，請稍後再試。"
            : error instanceof Error
            ? error.message
            : "目前無法連線到 AI 服務。";
      }
    } finally {
      window.clearTimeout(timeoutId);
      input.disabled = false;
      submitButton.disabled = false;
      input.focus();
    }
  });
</script>

<style is:global>
  .ai-chat {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 50;
    font-family: inherit;
  }

  .ai-chat__toggle {
    border: 0;
    border-radius: 999px;
    padding: 12px 20px;
    background: #171717;
    color: white;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 8px 30px rgb(0 0 0 / 18%);
  }

  .ai-chat__panel {
    position: absolute;
    right: 0;
    bottom: 64px;
    display: flex;
    width: min(380px, calc(100vw - 32px));
    height: min(540px, calc(100vh - 100px));
    flex-direction: column;
    overflow: hidden;
    border: 1px solid #dedbd4;
    border-radius: 18px;
    background: #fff;
    color: #171717;
    box-shadow: 0 18px 60px rgb(0 0 0 / 18%);
  }

  .ai-chat__panel[hidden] {
    display: none;
  }

  .ai-chat__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 18px;
    border-bottom: 1px solid #e8e5df;
  }

  .ai-chat__header p {
    margin: 4px 0 0;
    color: #6d6a64;
    font-size: 13px;
  }

  .ai-chat__close {
    border: 0;
    background: transparent;
    font-size: 24px;
    cursor: pointer;
  }

  .ai-chat__messages {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 12px;
    overflow-y: auto;
    padding: 18px;
    background: #f8f7f4;
  }

  .ai-message {
    max-width: 85%;
    border-radius: 14px;
    padding: 10px 13px;
    font-size: 14px;
    line-height: 1.6;
    white-space: pre-wrap;
  }

  .ai-message--assistant {
    align-self: flex-start;
    border: 1px solid #e0ddd6;
    background: white;
  }

  .ai-message--handoff {
    border-color: #d6a45d;
    background: #fffaf0;
  }

  .ai-message__handoff-label,
  .ai-message__sources-title {
    color: #9a5b13;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
      "Liberation Mono", monospace;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .ai-message__handoff-label {
    margin-bottom: 6px;
  }

  .ai-message__answer {
    white-space: pre-wrap;
  }

  .ai-message__sources {
    margin-top: 10px;
    padding-top: 8px;
    border-top: 1px solid #e8e5df;
    white-space: normal;
  }

  .ai-message__sources-title {
    color: #6d6a64;
  }

  .ai-message__sources-list {
    margin: 5px 0 0;
    padding-left: 18px;
    color: #6d6a64;
    font-size: 12px;
    overflow-wrap: anywhere;
  }

  .ai-message--user {
    align-self: flex-end;
    background: #171717;
    color: white;
  }

  .ai-chat__form {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 8px;
    padding: 14px;
    border-top: 1px solid #e8e5df;
  }

  .ai-chat__form input {
    min-width: 0;
    border: 1px solid #d7d3cb;
    border-radius: 10px;
    padding: 10px 12px;
    outline: none;
  }

  .ai-chat__form input:focus {
    border-color: #171717;
  }

  .ai-chat__form button {
    border: 0;
    border-radius: 10px;
    padding: 0 15px;
    background: #171717;
    color: white;
    cursor: pointer;
  }

  .ai-chat__form button:disabled {
    cursor: wait;
    opacity: 0.55;
  }

  @media (max-width: 480px) {
    .ai-chat {
      right: 16px;
      bottom: 16px;
    }
  }
</style>
