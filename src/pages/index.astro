---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import ResumeDownload from '@/components/ResumeDownload.astro';
import ContactForm from '@/components/ContactForm.astro';
import ProjectRow from '@/components/ProjectRow.astro';
import NoteRow from '@/components/NoteRow.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { SITE } from '@/site.config';

const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const sorted = [...allProjects].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = sorted.filter((entry) => entry.data.featured);
const rest = sorted.filter((entry) => !entry.data.featured);
const selected = [...featured, ...rest].slice(0, 5);
const allNotes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const recentNotes = allNotes.slice(0, 3);
---

<BaseLayout title={SITE.name}>
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-20 sm:pt-24">
    <p class="text-ink-soft mb-6 inline-flex items-center gap-2 font-mono text-xs">
      <span class="bg-signal h-1.5 w-1.5 rounded-full" aria-hidden="true"></span>
      {SITE.status}
    </p>

    <h1 class="font-display text-ink max-w-2xl text-4xl leading-[1.1] font-medium sm:text-5xl">
      {SITE.tagline}
    </h1>

    <p class="text-ink-soft mt-6 max-w-md">
      {SITE.role}
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-3">
      <Button href="/projects" variant="solid">View the projects →</Button>
      <Button href="#contact" variant="ghost">contact me</Button>
      <ResumeDownload />
    </div>
  </section>

  <section id="about" class="mx-auto max-w-3xl px-6 pb-20">
    <SectionHeading eyebrow="About" />
    <p class="text-ink-soft max-w-xl">
      {SITE.description}
    </p>
    <a href="/about" class="text-signal mt-4 inline-block font-mono text-xs hover:underline">
      More about me →
    </a>
  </section>

  <section id="projects" class="mx-auto max-w-3xl px-6 pb-20">
    <SectionHeading eyebrow="Selected projects" count={allProjects.length} />
    <div>
      {selected.map((entry) => <ProjectRow entry={entry} />)}
    </div>
    {
      allProjects.length > selected.length && (
        <div class="mt-6">
          <a
            href="/projects"
            class="text-ink-soft hover:text-signal font-mono text-xs transition-colors"
          >
            View all {allProjects.length} projects →
          </a>
        </div>
      )
    }
  </section>

  <section id="notes" class="mx-auto max-w-3xl px-6 pb-20">
    <SectionHeading eyebrow="Recent notes" count={allNotes.length} />
    <div>
      {recentNotes.map((entry) => <NoteRow entry={entry} />)}
    </div>
    {
      allNotes.length > recentNotes.length && (
        <div class="mt-6">
          <a
            href="/notes"
            class="text-ink-soft hover:text-signal font-mono text-xs transition-colors"
          >
            View all {allNotes.length} notes →
          </a>
        </div>
      )
    }
  </section>

  <section id="contact" class="mx-auto max-w-3xl px-6 pb-24">
    <div class="border-line bg-surface border p-7 sm:p-10">
      <SectionHeading eyebrow="Contact me" />
      <h2 class="font-display text-ink max-w-lg text-2xl sm:text-3xl">
        有想法、工作機會或合作提案嗎？
      </h2>
      <p class="text-ink-soft mt-4 max-w-2xl leading-7">
        歡迎留下訊息告訴我你想討論的事情。留言不會公開，我會透過你提供的 Email 與你聯絡。
      </p>

      <ContactForm />

      <p class="border-line text-ink-soft mt-8 border-t pt-6 font-mono text-xs">
        也可以直接寄信：
        <a href={`mailto:${SITE.email}`} class="text-signal hover:underline">{SITE.email}</a>
      </p>
    </div>
  </section>
</BaseLayout>
